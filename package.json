{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-event-sound",
  "version": "0.2.0",
  "description": "Speak sound cues via OS text-to-speech when opencode sessions go idle, error out, or request permission",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "sound",
    "tts",
    "notification",
    "macos",
    "say"
  ],
  "author": "dwyi84",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dwyi84/opencode-event-sound.git"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29",
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@opencode/plugin": "^2.0.27",
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  }
}
